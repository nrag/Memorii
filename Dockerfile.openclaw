# OpenClaw validation profile (additional-harnesses Docker validation).
# Pinned host: OpenClaw 2026.11.10.
ARG NODE_IMAGE=node:24.22.3-bookworm@sha256:49f7adaf9f1574bc45c20ea317139b39a59d7e758d0e93745e112fd85cb42623
FROM ${NODE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3 python3-dev python3-venv pkg-config libicu-dev git \
    && rm -rf /var/lib/apt/lists/*

# Supply the approved candidate directory as the memorii-wheel BuildKit context.
ARG MEMORII_WHEEL_SHA256
RUN --mount=from=memorii-wheel,target=/opt/memorii-wheel,ro \
    set -eu; \
    set -- /opt/memorii-wheel/memorii-*.whl; \
    test "$#" -eq 1; \
    printf '%s  %s\n' "$MEMORII_WHEEL_SHA256" "$1" | sha256sum --check --strict; \
    python3 -m venv /opt/memorii-venv; \
    /opt/memorii-venv/bin/python -m pip install "$1"

# The Node base's bundled npm contains older Undici and brace-expansion.
RUN npm install --global --ignore-scripts --no-audit --no-fund npm@12.2.3

# The plugin SDK and gateway CLI use the same lockfile-pinned installation.
COPY memorii/memorii/integrations/openclaw/plugin/package.json memorii/memorii/integrations/openclaw/plugin/package-lock.json /opt/memorii-openclaw/plugin/
RUN cd /opt/memorii-openclaw/plugin \
    && npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY memorii/memorii/integrations/openclaw/plugin/ /opt/memorii-openclaw/plugin/

ENV PATH="/opt/memorii-openclaw/plugin/node_modules/.bin:${PATH}"
ENV MEMORII_SIDECAR_URL=http://127.0.0.1:8762
WORKDIR /opt/memorii-openclaw
