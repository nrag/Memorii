# OpenClaw validation profile (additional-harnesses Docker validation).
# Pinned host: openclaw 2026.9.7 (npm, date-versioned) on Node 24-26.
ARG NODE_IMAGE=node:24-bookworm@sha256:64af3819f9275802414d7cdc38c27e9d82bd564dec4d4da87d008255d36c63b4
FROM ${NODE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3 python3-dev python3-venv pkg-config libicu-dev git \
    && rm -rf /var/lib/apt/lists/*

# Memorii runtime (sidecar host) installed into a dedicated venv.
COPY . /opt/memorii-src
RUN python3 -m venv /opt/memorii-venv \
    && /opt/memorii-venv/bin/python -m pip install --upgrade pip \
    && /opt/memorii-venv/bin/python -m pip install \
        --editable '/opt/memorii-src/memorii[local]'

# OpenClaw at the pinned version plus the Memorii memory plugin.
RUN npm install -g --ignore-scripts openclaw@2026.9.7 \
    && mkdir -p /opt/memorii-openclaw/plugin \
    && cp /opt/memorii-src/memorii/memorii/integrations/openclaw/plugin/* \
        /opt/memorii-openclaw/plugin/

ENV MEMORII_SIDECAR_URL=http://127.0.0.1:8762
ENV MEMORII_CREDENTIAL_PATH=/run/memorii/openclaw-plugin.credential
WORKDIR /opt/memorii-openclaw
