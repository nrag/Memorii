# Runtime profile
# Supported: local, test, ci, production
MEMORII_ENV=local

# Secret source override
# Optional. Supported: process, local_file, github_actions, azure_key_vault
# MEMORII_SECRET_SOURCE=local_file

# Local development
# Chezmoi should instantiate local private values at:
# ~/.config/memorii/memorii.env

# LLM runtime
# Supported providers: none, fake, openai, anthropic
MEMORII_LLM_PROVIDER=none
MEMORII_LLM_MODEL=
MEMORII_LLM_TIMEOUT_SECONDS=60
MEMORII_LLM_MAX_RETRIES=2

# Live LLM tests
# Keep false by default. Live tests also require a real provider API key.
MEMORII_ENABLE_LIVE_LLM_TESTS=false

# Provider secrets
# Leave blank in this tracked example file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Production Azure Key Vault
# Required only when MEMORII_ENV=production or MEMORII_SECRET_SOURCE=azure_key_vault.
MEMORII_AKV_URL=
# AZURE_KEY_VAULT_URL=
MEMORII_AKV_SECRET_NAMES=OPENAI_API_KEY,ANTHROPIC_API_KEY,MEMORII_LLM_MODEL
# MEMORII_AKV_SECRET_PREFIX=memorii-
