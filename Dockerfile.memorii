# The Windows Level 2 trial ran Hermes v0.21.4 (2026.9.21). Pass a verified
# immutable RepoDigest through HERMES_IMAGE when one is available.
ARG HERMES_IMAGE=nousresearch/hermes-agent:v2026.9.21
FROM ${HERMES_IMAGE}

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3-dev pkg-config libicu-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . /opt/memorii-src
RUN python3 /opt/memorii-src/tools/prepare_memorii_docker_context.py \
        --source-root /opt/memorii-src/memorii \
    && uv pip install --python /opt/hermes/.venv/bin/python \
        --editable '/opt/memorii-src/memorii[live]' \
    && /opt/hermes/.venv/bin/python -c \
        'from memorii.core.semantic_ingestion.project_assertions_profile import load_project_assertions_bundle; load_project_assertions_bundle()'
